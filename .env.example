# ProjectCast — Environment Configuration Template
# Copy this file to .env and insert your API keys

# 1. OpenAI API Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 2. Anthropic Claude API Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 3. OpenRouter Multi-Model Router API Configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# 4. Google Gemini API Configuration (Search Grounding & Analysis)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# 5. Hugging Face Inference API Configuration
HF_API_KEY=
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct

# 6. Local Ollama Server Settings
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:latest

# 7. Storage & Integration Connectors (Optional)
NOTION_INTEGRATION_TOKEN=
GOOGLE_DRIVE_CREDENTIALS_JSON=
